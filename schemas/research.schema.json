      "required": [
        "id",
        "from_id",
        "to_id",
        "relationship",
        "basis_evidence_ids",
        "observed_url",
        "locator",
        "observed_value",
        "observed_at",
        "extraction_method",
        "qualification",
        "decision_ref"
      ],
      "additionalProperties": false
    },
    "version": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "previous_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "thesis_id": {
          "type": "string",
          "minLength": 1
        },
        "thesis_version_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "Belief",
            "Hypothesis",
            "Question",
            "Practice"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "Current",
            "Proposed Update",
            "Challenged",
            "Retired"
          ]
        },
        "basis_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixture": {
          "type": "boolean"
        },
        "origin": {
          "enum": [
            "test_seed",
            "mark_decision"
          ]
        }
      },
      "required": [
        "id",
        "object_id",
        "version",
        "previous_version_id",
        "thesis_id",
        "thesis_version_id",
        "kind",
        "statement",
        "state",
        "basis_evidence_ids",
        "created_at",
        "decision_ref",
        "fixture",
        "origin"
      ],
      "additionalProperties": false
    },
    "proposal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_current_version_id": {
          "type": "string",
          "minLength": 1
        },
        "thesis_version_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "Proposed Update"
          ]
        },
        "basis_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reasoning": {
          "type": "string",
          "minLength": 1
        },
        "epistemic_status": {
          "enum": [
            "inference",
            "question"
          ]
        },
        "proposed_by": {
          "enum": [
            "Codex_assisted_fixture",
            "ChatGPT",
            "Mark"
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "const": true
        }
