      "required": [
        "id",
        "kind",
        "entity_id",
        "path"
      ],
      "additionalProperties": false
    },
    "batch": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "sequence",
        "previous_marker",
        "marker",
        "created_at",
        "events"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "path",
        "sha256",
        "byte_length"
      ],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "const": true
        },
        "generated_at": {
          "type": "string",
          "minLength": 1
        },
        "latest_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "latest_marker": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "string",
          "minLength": 1
        },
        "batches": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sequence": {
                "type": "integer",
                "minimum": 1
              },
              "marker": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "sequence",
              "marker",
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/file"
          }
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "fixture",
        "generated_at",
        "latest_sequence",
        "latest_marker",
        "coverage",
        "batches",
        "files"
      ],
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "codex_cli",
            "codex_web",
            "chatgpt_native"
          ]
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "last_sequence": {
          "type": "integer",
          "minimum": 0
        },
        "last_marker": {
          "type": [
            "string",
            "null"
          ]
        },
        "processed_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "receipt_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "consumer",
        "channel",
        "dataset_id",
        "last_sequence",
        "last_marker",
        "processed_event_ids",
        "receipt_refs",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "consumer": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "codex_cli",
            "codex_web",
            "chatgpt_native"
          ]
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "marker": {
          "type": "string",
          "minLength": 1
        },
        "processed_event_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "body_hashes_verified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observation_ref": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "consumer",
        "channel",
        "dataset_id",
        "sequence",
        "marker",
        "processed_event_ids",
        "body_hashes_verified",
        "observation_ref",
        "observed_at"
      ],
      "additionalProperties": false
    }
  }
}
