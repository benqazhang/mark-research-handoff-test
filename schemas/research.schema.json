    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "person",
            "organization",
            "repository",
            "channel",
            "podcast"
          ]
        },
        "qualification": {
          "enum": [
            "seed",
            "candidate",
            "qualified",
            "rejected"
          ]
        },
        "qualification_decision_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "platform",
        "native_id",
        "name",
        "url",
        "kind",
        "qualification",
        "qualification_decision_ref"
      ],
      "additionalProperties": false
    },
    "thesisVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "thesis_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "previous_version_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "enum": [
            "Current",
            "Proposed Update",
            "Challenged",
            "Retired"
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixture": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "thesis_id",
        "version",
        "previous_version_id",
        "question",
        "state",
        "created_at",
        "decision_ref",
        "fixture"
      ],
      "additionalProperties": false
    },
    "thesis": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "current_version_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "paused",
            "retired"
          ]
        }
      },
      "required": [
        "id",
        "current_version_id",
        "status"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "native_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "source_id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "enum": [
                "publisher",
                "author"
              ]
            }
          },
          "required": [
            "name",
            "source_id",
            "role"
          ],
          "additionalProperties": false
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string",
          "minLength": 1
        },
        "canonical_url": {
          "type": "string",
          "minLength": 1
        },
        "source_commit": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at_missing_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_updated_at": {
          "type": "string",
          "minLength": 1
        },
        "collected_at": {
          "type": "string",
          "minLength": 1
        },
        "content_kind": {
          "enum": [
            "repository_document",
            "post",
            "video",
            "podcast",
            "paper"
          ]
        },
        "body_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "completeness": {
          "enum": [
            "full",
            "partial",
            "metadata_only"
          ]
        },
        "transcript_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "transcript_missing_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "acquisition_method": {
          "type": "string",
          "minLength": 1
        },
        "retention_policy": {
          "type": "string",
          "minLength": 1
        },
        "attribution_path": {
          "type": "string",
          "minLength": 1
        },
        "discovery_edge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "id",
        "revision",
        "platform",
        "native_id",
        "source_id",
        "author",
        "title",
        "source_url",
        "canonical_url",
        "source_commit",
        "published_at",
        "published_at_missing_reason",
        "source_updated_at",
        "collected_at",
        "content_kind",
        "body_path",
        "sha256",
        "byte_length",
        "completeness",
        "transcript_path",
        "transcript_missing_reason",
        "acquisition_method",
        "retention_policy",
        "attribution_path",
        "discovery_edge_ids"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from_id": {
          "type": "string",
          "minLength": 1
        },
        "to_id": {
          "type": "string",
          "minLength": 1
        },
        "relationship": {
          "enum": [
            "mentions",
            "guest",
            "author",
            "repo_owner",
            "contributor",
            "quotes",
            "forwards",
            "linked_paper_author",
            "external_link"
          ]
        },
        "basis_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "observed_url": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "observed_value": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "minLength": 1
        },
        "extraction_method": {
          "enum": [
            "explicit_api_field",
            "explicit_link",
            "explicit_structured_field"
          ]
        },
        "qualification": {
          "enum": [
            "unreviewed",
            "accepted",
            "rejected"
          ]
        },
        "decision_ref": {
          "type": [
            "string",
            "null"
          ]
        }
