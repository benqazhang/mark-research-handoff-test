      "required": [
        "id",
        "object_id",
        "expected_current_version_id",
        "thesis_version_id",
        "statement",
        "state",
        "basis_evidence_ids",
        "reasoning",
        "epistemic_status",
        "proposed_by",
        "created_at",
        "fixture"
      ],
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_current_version_id": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "const": "Mark"
        },
        "action": {
          "enum": [
            "approve",
            "reject"
          ]
        },
        "verbatim": {
          "type": "string",
          "minLength": 1
        },
        "confirmation_ref": {
          "type": "string",
          "minLength": 1
        },
        "decided_at": {
          "type": "string",
          "minLength": 1
        },
        "result_version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "proposal_id",
        "proposal_sha256",
        "expected_current_version_id",
        "actor",
        "action",
        "verbatim",
        "confirmation_ref",
        "decided_at",
        "result_version_id"
      ],
      "additionalProperties": false
    },
    "cognition": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "current": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/version"
          }
        },
        "proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/proposal"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/decision"
          }
        }
      },
      "required": [
        "schema_version",
        "current",
        "versions",
        "proposals",
        "decisions"
      ],
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "evidence_added",
            "evidence_revised",
            "evidence_withdrawn",
            "source_discovered",
            "cognitive_proposed",
            "cognitive_decided",
            "validation_ping"
          ]
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
